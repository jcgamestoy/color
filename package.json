{
  "name": "@retrovm/color",
  "version": "0.2.0",
  "description": "Immutable and mutable RGB color classes with HSV, ANSI, and named color support",
  "author": "Juan Carlos González Amestoy",
  "license": "MIT",
  "type": "module",
  "module": "src/color.ts",
  "exports": {
    ".": {
      "bun": "./src/color.ts",
      "import": "./dist/color.js",
      "types": "./dist/color.d.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/color.ts --outdir dist --target browser && tsc -p tsconfig.build.json",
    "release": "bun run build && bun publish"
  },
  "keywords": [
    "color",
    "rgb",
    "hsv",
    "ansi",
    "terminal"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
